---
const { title = 'Mi Blog' } = Astro.props; const b = import.meta.env.BASE_URL.replace(/\/$/,'');
---
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><link rel="alternate" type="application/rss+xml" href={`${b}/rss.xml`}>
<script is:inline>document.documentElement.dataset.theme=localStorage.theme||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark')</script>
<style is:global>
:root{--bg:#0a0a0a;--fg:#ededed;--mut:#8a8a8a;--bd:#262626;--ac:#5b9dff;--card:#111}
[data-theme=light]{--bg:#fff;--fg:#111;--mut:#666;--bd:#e3e3e3;--ac:#1a56db;--card:#fafafa}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.7 system-ui,sans-serif}
a{color:inherit}.mono{font-family:ui-monospace,Menlo,monospace;font-size:.8rem;color:var(--mut)}
.wrap{max-width:1100px;margin:0 auto;padding:0 1rem}
nav{border-bottom:1px solid var(--bd)}nav .wrap{display:flex;gap:1.2rem;align-items:center;height:56px}
nav .sp{flex:1}button,.btn{background:none;border:1px solid var(--bd);color:var(--fg);padding:.35rem .8rem;border-radius:6px;cursor:pointer;font:inherit;font-size:.9rem}
.btn.p{background:var(--ac);border-color:var(--ac);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1rem;margin:1.5rem 0}
.card{border:1px solid var(--bd);background:var(--card);border-radius:8px;overflow:hidden;text-decoration:none;display:block}
.card img,.ph{width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--bd);display:block}.card div{padding:.8rem}
.card h3{margin:.3rem 0;font-size:1rem;line-height:1.3}
.tag{border:1px solid var(--bd);padding:.1rem .5rem;border-radius:4px;font:.75rem ui-monospace,monospace;margin-right:.3rem;text-decoration:none;color:var(--mut);cursor:pointer;background:none}
.tag.on{border-color:var(--ac);color:var(--ac)}
input,textarea{width:100%;background:var(--card);color:var(--fg);border:1px solid var(--bd);border-radius:6px;padding:.6rem;font:inherit}
.post{display:grid;grid-template-columns:minmax(0,720px) 220px;gap:2rem;justify-content:center}
@media(max-width:900px){.post{grid-template-columns:1fr}.toc{display:none}}
.toc{position:sticky;top:1rem;align-self:start;font-size:.85rem}.toc a{display:block;color:var(--mut);text-decoration:none;padding:.15rem 0}
.prose img{max-width:100%}.prose pre{background:var(--card);border:1px solid var(--bd);padding:1rem;overflow:auto;border-radius:6px}
.prose a{color:var(--ac)}.cm{border-top:1px solid var(--bd);padding:.8rem 0}.cm .re{margin-left:1.5rem;border-left:2px solid var(--bd);padding-left:.8rem}
</style></head><body>
<nav><div class="wrap"><a href={`${b}/`}><b>Mi<span style="color:var(--ac)">Blog</span></b></a><a href={`${b}/`}>Contenido</a><a href={`${b}/#newsletter`}>Newsletter</a>
<span class="sp"></span><button id="theme" aria-label="tema">◐</button><button id="auth">Entrar →</button></div></nav>
<slot />
<footer class="wrap mono" style="padding:3rem 0">© {new Date().getFullYear()} · <a href={`${b}/rss.xml`}>rss</a></footer>
<script>
import { sb } from '../lib/supabase';
document.getElementById('theme')!.onclick=()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;localStorage.theme=t};
const a=document.getElementById('auth')!;
sb.auth.getSession().then(({data})=>{a.textContent=data.session?'Salir':'Entrar →'});
a.onclick=async()=>{const{data}=await sb.auth.getSession();
 if(data.session){await sb.auth.signOut();location.reload()}
 else await sb.auth.signInWithOAuth({provider:'google',options:{redirectTo:location.href}})};
</script></body></html>
